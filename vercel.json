{
  "version": 2,
  "buildCommand": "pnpm run build",
  "builds": [
    {
      "src": "dist/app/api/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/app/infra/migrations/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/app/api/server.js"
    }
  ]
}
