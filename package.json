{
  "name": "buzzy-finance-backend",
  "version": "1.0.0",
  "description": "",
  "main": "app/api/server.ts",
  "scripts": {
    "dev": "pnpm run compose:up && tsx --env-file=.env.development app/infra/scripts/waitForPostgres.ts && pnpm run migrate:up && tsx watch --env-file=.env.development app/api/server.ts",
    "dev:test": "pnpm run compose:up && tsx --env-file=.env.test app/infra/scripts/waitForPostgres.ts && pnpm run migrate:up && tsx watch --env-file=.env.test app/api/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app/api/server.js",
    "lint:prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint:prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint:eslint:check": "eslint .",
    "prepare": "husky",
    "test": "pnpm run compose:up && NODE_ENV=test tsx --env-file=.env.test app/infra/scripts/waitForPostgres.ts && concurrently -n express,jest $([ -n \"$CI\" ] || printf '%s' '--hide express') -k --success command-jest \"tsx watch --env-file=.env.test app/api/server.ts\" \"jest --runInBand\"",
    "watch": " jest --watch --verbose --runInBand",
    "compose:up": "docker compose -f ./app/infra/docker/docker-compose.yml up -d",
    "compose:stop": "docker compose -f ./app/infra/docker/docker-compose.yml stop",
    "compose:down": "docker compose -f ./app/infra/docker/docker-compose.yml down",
    "migrate": "node-pg-migrate -j ts",
    "migrate:create": "node-pg-migrate -j ts -m ./app/infra/migrations create",
    "migrate:up": "NODE_OPTIONS='--import tsx' node-pg-migrate  -j ts -m ./app/infra/migrations --envPath .env.development up",
    "migrate:down": " node-pg-migrate -j ts -m ./app/infra/migrations  --envPath .env.development down",
    "migrate:redo": " node-pg-migrate  -j ts -m ./app/infra/migrations --envPath .env.development redo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustapfp/buzzy-finance-service.git"
  },
  "author": "gustapfp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gustapfp/buzzy-finance-service/issues"
  },
  "homepage": "https://github.com/gustapfp/buzzy-finance-service#readme",
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^8.0.2",
    "async-retry": "^1.3.3",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.6",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/async-retry": "^1.4.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.8",
    "@types/pg": "^8.23.1",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "3.8.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
